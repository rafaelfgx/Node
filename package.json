{
    "name": "node",
    "version": "1.0.0",
    "license": "MIT",
    "type": "module",
    "scripts": {
        "update": "npx npm-check-updates -u",
        "check": "prettier . --check && eslint .",
        "fix": "prettier . --write && eslint . --fix",
        "test": "vitest run --coverage",
        "test:watch": "vitest",
        "start": "tsx watch --env-file=.env src/main.ts",
        "build": "tsc -p tsconfig.build.json"
    },
    "imports": {
        "#src/*": "./dist/*"
    },
    "dependencies": {
        "cors": "2.8.6",
        "express": "5.3.0",
        "helmet": "8.3.0",
        "mongodb": "7.7.0",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@types/cors": "2.8.19",
        "@types/express": "5.0.6",
        "@types/node": "26.6.5",
        "@types/supertest": "7.2.1",
        "@vitest/coverage-v8": "5.0.5",
        "eslint": "10.13.0",
        "eslint-config-prettier": "10.1.8",
        "globals": "17.13.0",
        "prettier": "3.9.10",
        "supertest": "7.3.1",
        "testcontainers": "12.2.1",
        "tsx": "4.23.15",
        "typescript": "6.0.3",
        "typescript-eslint": "8.72.0",
        "vitest": "5.0.5"
    },
    "allowScripts": {
        "cpu-features@0.0.10": true,
        "esbuild@0.28.2": true,
        "protobufjs@7.6.6": true,
        "ssh2@1.17.0": true
    }
}
